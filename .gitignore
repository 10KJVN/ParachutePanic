# =========================
# UNITY PROJECT GITIGNORE
# =========================
# Source: Adapted from GitHub Unity.gitignore
# Modified for:
# - Visual Studio 2022
# - VS Code
# - JetBrains Rider
# - Nested project setup
# =========================

# --- Unity generated folders ---
*/[Ll]ibrary/
*/[Tt]emp/
*/[Oo]bj/
*/[Bb]uild/
*/[Bb]uilds/
*/[Ll]ogs/
*/[Uu]ser[Ss]ettings/
*/[Mm]emoryCaptures/
*/[Rr]ecordings/
*/[Pp]ackages/com.unity.package-manager/
*/[Pp]ackages/packages-lock.json

# --- Autogenerated Rider plugin ---
*/[Aa]ssets/Plugins/Editor/JetBrains*

# --- Unity specific files ---
*.unitypackage
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
sysinfo.txt
*.log

# --- Crashlytics / Analytics ---
crashlytics-build.properties

# --- Addressables ---
*/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# --- Build outputs ---
*.apk
*.aab
*.app
*.exe
*.x86
*.x86_64
*.zip
*.tar.gz

# --- Visual Studio ---
.vs/
*.csproj
*.unityproj
*.sln
*.vcxproj*
*.vcproj*
*.dbmdl
*.jfm
*.pdb
*.cachefile
*.db

# --- JetBrains Rider ---
.idea/
.idea.*
*.sln.iml

# --- Visual Studio Code ---
.vscode/
.history/
*.code-workspace

# --- Gradle ---
.gradle/
gradle-app.setting
local.properties

# --- OS generated files ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# --- Temporary or cache folders ---
*.stackdump
*.pid
*.seed
*.bak
*.old
